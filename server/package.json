{
  "name": "ghostwheels-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP aggregator server for Personal AI Extension Manager",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun dist/index.js",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "aggregator",
    "server",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "json5": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/express": "^5.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "sinon": "^20.0.0",
    "typescript": "^5.3.2"
  }
}
