{
  "name": "abc-server",
  "version": "1.0.0",
  "description": "Service for ABC (Adaptive Business Context) project.",
  "main": "dist/index.js",
  "scripts": {
    "build:dts": "tsup src/index.ts --dts --format cjs,esm --clean",
    "build": "tsup src/index.ts --format cjs,esm --clean --minifyIdentifiers",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "mocha -r ts-node/register \"test/**/*.test.ts\" --timeout 10000"
  },
  "keywords": [
    "api",
    "server",
    "abc",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "json5": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "typed-rpc": "^6.1.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/express": "^5.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "chai": "^5.2.0",
    "eslint": "^8.54.0",
    "mocha": "^11.1.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.3.2"
  }
}
