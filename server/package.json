{
  "name": "ghostwheels-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP aggregator server for Personal AI Extension Manager",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:standalone": "bun build src/index.ts --compile --outfile dist/abc-server",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "circular": "madge --circular --extensions ts src/"
  },
  "keywords": [
    "mcp",
    "aggregator",
    "server",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "json5": "^2.2.3",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bun": "^1.3.6",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.30",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "knip": "^5.81.0",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.0",
    "typescript": "^5.3.2"
  }
}
