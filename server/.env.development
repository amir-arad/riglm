# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Options: in-memory, sqlite
DB_TYPE=in-memory
# Only used when DB_TYPE is sqlite
SQLITE_DB_PATH=./data/database.sqlite

# JWT Configuration
# IMPORTANT: Replace with a strong secret in production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# # OAuth Configuration
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
# OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:8080

# Security
# Comma-separated list of allowed domains for redirect URLs
ALLOWED_REDIRECT_DOMAINS=localhost,example.com