{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Context",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "User-friendly name"
    },
    "description": {
      "type": "string",
      "description": "Purpose description"
    },
    "version": {
      "type": "string",
      "description": "Semantic versioning",
      "default": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"],
      "default": "draft",
      "description": "Context status"
    },
    "guidelines": {
      "type": "string",
      "description": "Usage guidelines"
    },
    "tools": {
      "type": "array",
      "description": "Tools included in this context",
      "items": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "description": "Source server ID"
          },
          "originalName": {
            "type": "string",
            "description": "Original tool name"
          },
          "exposedName": {
            "type": "string",
            "description": "Name to expose (for aliasing)"
          },
          "description": {
            "type": "string",
            "description": "Optional override description"
          },
          "inputSchema": {
            "type": "object",
            "description": "JSON Schema for parameters"
          },
          "configuration": {
            "type": "object",
            "description": "Tool-specific configuration"
          }
        },
        "required": ["serverId", "originalName"]
      }
    }
  },
  "required": ["name"]
}
