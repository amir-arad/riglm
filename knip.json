{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "test/**/*.test.ts",
    "test/fixtures/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/index.ts"
  ],
  "ignoreDependencies": [
    "bun-types"
  ],
  "ignoreBinaries": [
    "dist/index.js"
  ],
  "ignoreExportsUsedInFile": true,
  "eslint": {
    "config": [".eslintrc.*", "eslint.config.*"]
  }
}
