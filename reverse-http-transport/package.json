{
  "name": "reverse-http-mcp",
  "version": "1.0.0",
  "description": "Production-ready SOCKS-based reverse HTTP transport for Model Context Protocol using SOCKS proxy + official MCP SDK",
  "main": "src/demo.js",
  "type": "module",
  "scripts": {
    "start": "node lib/example-usage.js",
    "start:tunnel-server": "node scripts/setup-tunnel-server.js",
    "start:tunnel-client": "node scripts/setup-tunnel-client.js",
    "test": "node --test-reporter tap --test",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.18.2",
    "socks-proxy-agent": "^8.0.2",
    "socksv5": "^0.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reverse-http",
    "socks-proxy",
    "tunnel",
    "enterprise"
  ]
}
