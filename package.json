{
  "name": "riglm",
  "version": "0.0.2",
  "type": "module",
  "description": "MCP router for AI Extension Manager",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:standalone": "bun build src/index.ts --compile --outfile dist/riglm",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "circular": "madge --circular --extensions ts src/",
    "deps:check": "depcruise src --config",
    "deps:graph": "depcruise src --config --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "deps:graph:html": "depcruise src --config --output-type archi | depcruise-wrap-stream-in-html > docs/dependency-graph.html",
    "deps:all": "bun run deps:check && bun run deps:graph && bun run deps:graph:html",
    "preversion": "bun run lint && bun run typecheck && bun run deps:check && bun test",
    "version": "git add -A",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "keywords": [
    "mcp",
    "router",
    "server",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "json5": "^2.2.3",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/bun": "^1.3.6",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.30",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "dependency-cruiser": "^17.3.6",
    "eslint": "^8.54.0",
    "eslint-plugin-no-comments": "^1.1.10",
    "globals": "^17.0.0",
    "knip": "^5.82.0",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.0",
    "typescript": "^5.3.2"
  }
}
